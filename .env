# Meliora web front end - TEST SERVER (192.168.22.170)
# Only REACT_APP_* variables reach the browser, so no secrets belong here.
# Restart `npm start` / rebuild after changing this file.

# dev server (the API allows the origin http://192.168.22.170:3000 in its CORS list)
PORT=3000
CHOKIDAR_USEPOLLING=true

# ---- Server addresses (test server) ----
REACT_APP_API_URL=http://192.168.22.170:7000/api
REACT_APP_WS_URL=http://192.168.22.170:7000
REACT_APP_ELLIDER_API_URL=http://192.168.22.170:6001/api
REACT_APP_API_URL_KMC=http://192.168.22.170:5001/api
REACT_APP_PUBLIC_NAS_FOLDER=http://192.168.22.170
