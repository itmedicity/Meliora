# Meliora (web front end, Create React App) - environment template
# Copy to ".env" (or .env.production for a production build). Only variables that
# start with REACT_APP_ are exposed to the browser, so NEVER put secrets here.
# Every REACT_APP_* value below is optional: when unset, the built-in default in
# src/views/Constant/Static.js is used.

# dev server
PORT=3000
CHOKIDAR_USEPOLLING=true

# ---- Server addresses ----
# Meliora_API base URL (include /api)
REACT_APP_API_URL=http://localhost:7000/api
# socket.io address (same host/port as the API, without /api)
REACT_APP_WS_URL=http://localhost:7000
# Ellider API base URL
REACT_APP_ELLIDER_API_URL=http://localhost:6001/api
# KMC API base URL
REACT_APP_API_URL_KMC=http://localhost:5001/api
# base address used to load files stored on the NAS
REACT_APP_PUBLIC_NAS_FOLDER=http://localhost
